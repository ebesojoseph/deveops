<section class="auth-card">
  <h1>Log in</h1>

  <% if (errors && errors.length) { %>
    <div class="alert alert-error">
      <ul>
        <% errors.forEach(function(err) { %>
          <li><%= err %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/login" method="POST" class="form">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= form.email || '' %>" required />

    <label for="password">Password</label>
    <input type="password" id="password" name="password" required />

    <button type="submit" class="btn">Log in</button>
  </form>

  <p class="auth-switch">Don't have an account? <a href="/register">Sign up</a></p>

  <p class="hint">Seeded test accounts (after running <code>npm run seed</code>):<br />
    ada@example.com / grace@example.com / alan@example.com &mdash; password: <code>password123</code>
  </p>
</section>
